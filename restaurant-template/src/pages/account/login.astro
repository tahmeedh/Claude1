---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LoginForm from '../../components/auth/LoginForm';

const next = Astro.url.searchParams.get('next') ?? '/account/orders';

// Already logged in → redirect
if (Astro.locals.user) return Astro.redirect(next);
---

<BaseLayout title="Sign In">
  <div class="mx-auto max-w-sm px-4 py-16">
    <div class="text-center mb-8">
      <h1 class="text-2xl font-bold">Welcome back</h1>
      <p class="text-muted-foreground mt-2">Sign in to track orders and earn rewards</p>
    </div>
    <LoginForm client:load mode="magic" next={next} />
  </div>
</BaseLayout>
