---
import BaseLayout from '../layouts/BaseLayout.astro';
import LoyaltyCard from '../components/loyalty/LoyaltyCard';

const user = Astro.locals.user;
const supabase = Astro.locals.supabase;

let loyaltyPoints = 0;
let lifetimePoints = 0;
let transactions: { id: string; points: number; reason: string; created_at: string }[] = [];

if (user) {
  const [{ data: profile }, { data: txns }] = await Promise.all([
    supabase.from('profiles').select('loyalty_points,lifetime_points').eq('id', user.id).single(),
    supabase.from('loyalty_transactions').select('id,points,reason,created_at').eq('user_id', user.id).order('created_at', { ascending: false }).limit(50),
  ]);
  loyaltyPoints = profile?.loyalty_points ?? 0;
  lifetimePoints = profile?.lifetime_points ?? 0;
  transactions = txns ?? [];
}

const { data: rewards } = await supabase
  .from('loyalty_rewards')
  .select('*')
  .eq('is_active', true)
  .order('points_cost');
---

<BaseLayout title="Loyalty Program" description="Earn points and redeem rewards.">
  <div class="mx-auto max-w-4xl px-4 py-10">
    <h1 class="text-3xl font-bold mb-2">Loyalty Rewards</h1>
    <p class="text-muted-foreground mb-8">Earn 1 point for every $1 you spend. Redeem points for discounts and free items.</p>

    {!user && (
      <div class="rounded-lg border bg-muted/40 p-6 text-center mb-8">
        <p class="font-medium">Sign in to view your points and rewards</p>
        <a href="/account/login?next=/loyalty" class="mt-3 inline-block rounded-md bg-primary px-4 py-2 text-sm text-primary-foreground">Sign In</a>
      </div>
    )}

    <LoyaltyCard
      client:load
      loyaltyPoints={loyaltyPoints}
      lifetimePoints={lifetimePoints}
      rewards={rewards ?? []}
      transactions={transactions}
    />
  </div>
</BaseLayout>
