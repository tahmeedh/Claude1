---
import BaseLayout from '../layouts/BaseLayout.astro';

const supabase = Astro.locals.supabase;
const { data: featured } = supabase ? await supabase
  .from('menu_items')
  .select('id,name,description,price_cents,image_url')
  .eq('is_featured', true)
  .eq('is_available', true)
  .limit(3) : { data: null };
---

