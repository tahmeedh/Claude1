        <rect x="158" y="202" width="26" height="40" fill="#a87850" rx="3"/>
        <circle cx="147" cy="224" r="3" fill="#d4a060"/>
        <circle cx="163" cy="224" r="3" fill="#d4a060"/>
        <!-- Flower pots -->
        <ellipse cx="30" cy="256" rx="18" ry="10" fill="#8b6040"/>
        <rect x="16" y="240" width="28" height="16" fill="#9b7050" rx="2"/>
        <circle cx="22" cy="236" r="8" fill="#60a840"/>
        <circle cx="30" cy="232" r="10" fill="#70c050"/>
        <circle cx="38" cy="236" r="8" fill="#60a840"/>
        <!-- pink flowers -->
        <circle cx="22" cy="230" r="4" fill="#ff90a0"/>
        <circle cx="30" cy="226" r="4" fill="#ff70a0"/>
        <circle cx="38" cy="230" r="4" fill="#ff90a0"/>
        <ellipse cx="280" cy="256" rx="18" ry="10" fill="#8b6040"/>
        <rect x="266" y="240" width="28" height="16" fill="#9b7050" rx="2"/>
        <circle cx="272" cy="236" r="8" fill="#60a840"/>
        <circle cx="280" cy="232" r="10" fill="#70c050"/>
        <circle cx="288" cy="236" r="8" fill="#60a840"/>
        <circle cx="272" cy="230" r="4" fill="#ff90a0"/>
        <circle cx="280" cy="226" r="4" fill="#ff70a0"/>
        <circle cx="288" cy="230" r="4" fill="#ff90a0"/>

        <!-- ===== LEFT BUSH / TREE ===== -->
        <rect x="295" y="220" width="16" height="38" fill="#6b4226" rx="4"/>
        <ellipse cx="303" cy="214" rx="30" ry="28" fill="#5ab840"/>
        <ellipse cx="285" cy="222" rx="22" ry="20" fill="#4aaa30"/>
        <ellipse cx="322" cy="222" rx="22" ry="20" fill="#4aaa30"/>
        <ellipse cx="303" cy="200" rx="24" ry="22" fill="#6acf50"/>

        <!-- ===== CENTRE MAIN BUILDING ===== -->
        <!-- Building body -->
        <rect x="380" y="75" width="680" height="185" fill="#f5f3ec" rx="4"/>
        <!-- Roof stripe -->
        <rect x="380" y="70" width="680" height="14" fill="#f0b8c8" rx="3"/>
        <!-- Roof trim -->
        <rect x="380" y="82" width="680" height="6" fill="#e8a0b8"/>
        <!-- Name sign -->
        <rect x="500" y="88" width="440" height="55" fill="#fff8f5" rx="10"/>
        <rect x="504" y="92" width="432" height="47" fill="#fff0e8" rx="8"/>
        <rect x="508" y="96" width="424" height="39" fill="none" stroke="#f0a0b8" stroke-width="2" rx="6"/>
        <!-- Arched windows left side -->
        <rect x="395" y="148" width="70" height="90" fill="#f0b4d0" rx="35" opacity="0.95"/>
        <rect x="398" y="150" width="64" height="55" fill="#fce0ee" rx="32" opacity="0.9"/>
        <rect x="475" y="148" width="70" height="90" fill="#c8aae8" rx="35" opacity="0.95"/>
        <rect x="478" y="150" width="64" height="55" fill="#e8d8fc" rx="32" opacity="0.9"/>
        <!-- Arched windows right side -->
        <rect x="895" y="148" width="70" height="90" fill="#f0b4d0" rx="35" opacity="0.95"/>
        <rect x="898" y="150" width="64" height="55" fill="#fce0ee" rx="32" opacity="0.9"/>
        <rect x="975" y="148" width="70" height="90" fill="#c8aae8" rx="35" opacity="0.95"/>
        <rect x="978" y="150" width="64" height="55" fill="#e8d8fc" rx="32" opacity="0.9"/>
        <!-- Main door (double) -->
        <rect x="660" y="175" width="120" height="90" fill="#8b5e3c" rx="8"/>
        <rect x="666" y="180" width="48" height="60" fill="#a07050" rx="4"/>
        <rect x="726" y="180" width="48" height="60" fill="#a07050" rx="4"/>
        <circle cx="716" cy="212" r="4" fill="#d4a060"/>
        <circle cx="724" cy="212" r="4" fill="#d4a060"/>
        <!-- Door arch -->
        <ellipse cx="720" cy="178" rx="60" ry="20" fill="#8b5e3c"/>
        <ellipse cx="720" cy="176" rx="55" ry="16" fill="#9b6e4c"/>
        <!-- Side doors -->
        <rect x="560" y="195" width="80" height="70" fill="#9b6e4c" rx="6"/>
        <rect x="800" y="195" width="80" height="70" fill="#9b6e4c" rx="6"/>
        <!-- Flower boxes under windows -->
        <rect x="393" y="232" width="76" height="14" fill="#c87890" rx="4"/>
        <rect x="473" y="232" width="76" height="14" fill="#c87890" rx="4"/>
        <rect x="893" y="232" width="76" height="14" fill="#c87890" rx="4"/>
        <rect x="973" y="232" width="76" height="14" fill="#c87890" rx="4"/>
        <!-- Flowers in boxes -->
        <circle cx="400" cy="228" r="5" fill="#ff8098"/>
        <circle cx="415" cy="225" r="6" fill="#ff60a0"/>
        <circle cx="430" cy="228" r="5" fill="#ff8098"/>
        <circle cx="445" cy="225" r="6" fill="#ffb0c0"/>
        <circle cx="460" cy="228" r="5" fill="#ff8098"/>
        <circle cx="480" cy="228" r="5" fill="#ff8098"/>
        <circle cx="495" cy="225" r="6" fill="#ff60a0"/>
        <circle cx="510" cy="228" r="5" fill="#ff8098"/>
        <circle cx="525" cy="225" r="6" fill="#ffb0c0"/>
        <circle cx="540" cy="228" r="5" fill="#ff8098"/>
        <circle cx="900" cy="228" r="5" fill="#ff8098"/>
        <circle cx="915" cy="225" r="6" fill="#ff60a0"/>
        <circle cx="930" cy="228" r="5" fill="#ff8098"/>
        <circle cx="945" cy="225" r="6" fill="#ffb0c0"/>
        <circle cx="960" cy="228" r="5" fill="#ff8098"/>
        <circle cx="980" cy="228" r="5" fill="#ff8098"/>
        <circle cx="995" cy="225" r="6" fill="#ff60a0"/>
        <circle cx="1010" cy="228" r="5" fill="#ff8098"/>
        <circle cx="1025" cy="225" r="6" fill="#ffb0c0"/>
        <circle cx="1040" cy="228" r="5" fill="#ff8098"/>

        <!-- ===== CENTRE BUSH / TREES ===== -->
        <!-- Left of main entrance -->
        <rect x="340" y="215" width="18" height="42" fill="#6b4226" rx="4"/>
        <ellipse cx="349" cy="208" rx="36" ry="32" fill="#52b038"/>
        <ellipse cx="328" cy="220" rx="26" ry="24" fill="#42a028"/>
        <ellipse cx="370" cy="220" rx="26" ry="24" fill="#42a028"/>
        <ellipse cx="349" cy="192" rx="28" ry="26" fill="#62c848"/>
        <!-- Right of main entrance -->
        <rect x="1082" y="215" width="18" height="42" fill="#6b4226" rx="4"/>
        <ellipse cx="1091" cy="208" rx="36" ry="32" fill="#52b038"/>
        <ellipse cx="1070" cy="220" rx="26" ry="24" fill="#42a028"/>
        <ellipse cx="1112" cy="220" rx="26" ry="24" fill="#42a028"/>
        <ellipse cx="1091" cy="192" rx="28" ry="26" fill="#62c848"/>

        <!-- ===== RIGHT BUILDING (warm yellow) ===== -->
        <rect x="1130" y="105" width="310" height="155" fill="#f5f0e0" rx="4"/>
        <rect x="1130" y="100" width="310" height="12" fill="#e0d090" rx="2"/>
        <!-- Sign -->
        <rect x="1180" y="115" width="210" height="45" fill="#fffce0" rx="8"/>
        <rect x="1183" y="118" width="204" height="39" fill="#fff8d0" rx="6"/>
        <text x="1285" y="143" text-anchor="middle" font-size="18" font-weight="bold" fill="#c09020" font-family="sans-serif">Bella Vista</text>
        <!-- Arched windows -->
        <rect x="1145" y="165" width="55" height="70" fill="#f8d890" rx="28" opacity="0.9"/>
        <rect x="1147" y="167" width="51" height="42" fill="#fff8d0" rx="26" opacity="0.8"/>
        <rect x="1210" y="165" width="55" height="70" fill="#f0c070" rx="28" opacity="0.9"/>
        <rect x="1212" y="167" width="51" height="42" fill="#fff0b0" rx="26" opacity="0.8"/>
        <rect x="1275" y="165" width="55" height="70" fill="#f8d890" rx="28" opacity="0.9"/>
        <rect x="1277" y="167" width="51" height="42" fill="#fff8d0" rx="26" opacity="0.8"/>
        <!-- Door -->
        <rect x="1340" y="198" width="70" height="62" fill="#8b5e3c" rx="6"/>
        <rect x="1346" y="202" width="26" height="40" fill="#a87850" rx="3"/>
        <rect x="1378" y="202" width="26" height="40" fill="#a87850" rx="3"/>
        <!-- Flower pots -->
        <ellipse cx="1155" cy="256" rx="18" ry="10" fill="#8b6040"/>
        <rect x="1141" y="240" width="28" height="16" fill="#9b7050" rx="2"/>
        <circle cx="1147" cy="236" r="8" fill="#60a840"/>
        <circle cx="1155" cy="232" r="10" fill="#70c050"/>
        <circle cx="1163" cy="236" r="8" fill="#60a840"/>
        <circle cx="1147" cy="230" r="4" fill="#ffe060"/>
        <circle cx="1155" cy="226" r="4" fill="#ffc030"/>
        <circle cx="1163" cy="230" r="4" fill="#ffe060"/>
        <ellipse cx="1415" cy="256" rx="18" ry="10" fill="#8b6040"/>
        <rect x="1401" y="240" width="28" height="16" fill="#9b7050" rx="2"/>
        <circle cx="1407" cy="236" r="8" fill="#60a840"/>
        <circle cx="1415" cy="232" r="10" fill="#70c050"/>
        <circle cx="1423" cy="236" r="8" fill="#60a840"/>
        <circle cx="1407" cy="230" r="4" fill="#ffe060"/>
        <circle cx="1415" cy="226" r="4" fill="#ffc030"/>
        <circle cx="1423" cy="230" r="4" fill="#ffe060"/>

        <!-- ===== SIGN POLES ===== -->
        <!-- Left pole with star sign -->
        <rect x="312" y="130" width="8" height="128" fill="#b0b8c8" rx="3"/>
        <rect x="293" y="108" width="46" height="46" fill="#f8d840" rx="6"/>
        <rect x="297" y="112" width="38" height="38" fill="#fae850" rx="4"/>
        <polygon points="316,118 320,128 332,128 323,135 326,145 316,139 306,145 309,135 300,128 312,128" fill="#f0a020"/>
        <!-- Right pole with star sign -->
        <rect x="1120" y="130" width="8" height="128" fill="#b0b8c8" rx="3"/>
        <rect x="1101" y="108" width="46" height="46" fill="#f8d840" rx="6"/>
        <rect x="1105" y="112" width="38" height="38" fill="#fae850" rx="4"/>
        <polygon points="1124,118 1128,128 1140,128 1131,135 1134,145 1124,139 1114,145 1117,135 1108,128 1120,128" fill="#f0a020"/>

        <!-- ===== WALKING CHARACTERS ===== -->
        <!-- Character 1 (left side, walking right) -->
        <g class="char-walk-1">
          <ellipse cx="100" cy="228" rx="12" ry="14" fill="#f9d0a0"/>
          <rect x="90" y="240" width="20" height="16" fill="#e06080" rx="3"/>
          <rect x="90" y="254" width="8" height="12" fill="#4060c0" rx="2"/>
          <rect x="103" y="254" width="8" height="12" fill="#4060c0" rx="2"/>
          <circle cx="100" cy="220" r="10" fill="#f9d0a0"/>
          <rect x="88" y="214" width="24" height="8" fill="#c04060" rx="4"/>
        </g>
        <!-- Character 2 (right side, walking left) -->
        <g class="char-walk-2">
          <ellipse cx="1340" cy="228" rx="12" ry="14" fill="#f9d0a0"/>
          <rect x="1330" y="240" width="20" height="16" fill="#60c080" rx="3"/>
          <rect x="1330" y="254" width="8" height="12" fill="#804020" rx="2"/>
          <rect x="1343" y="254" width="8" height="12" fill="#804020" rx="2"/>
          <circle cx="1340" cy="220" r="10" fill="#f9d0a0"/>
          <rect x="1328" y="213" width="24" height="9" fill="#805000" rx="4"/>
        </g>
      </svg>
    </div>

    <!-- Hero content (overlay) -->
    <div class="relative z-10 mx-auto max-w-3xl text-center px-4 pt-16 pb-64">
      <div class="rc-badge inline-block mb-4 px-5 py-2 rounded-full text-sm font-bold uppercase tracking-widest">
        ✨ Now Serving
      </div>
      <h1 class="rc-title text-5xl font-bold tracking-tight sm:text-6xl">
        Taste the Difference
      </h1>
      <p class="rc-sub mt-5 text-lg max-w-xl mx-auto">
        Fresh ingredients, bold flavors, memorable moments. Order online or book your table.
      </p>
      <div class="mt-8 flex flex-wrap gap-4 justify-center">
        <a href="/menu" class="rc-btn-primary rounded-2xl px-8 py-3.5 text-base font-bold shadow-xl transition-all hover:scale-105 hover:-translate-y-0.5 active:scale-95">
          🍽 Order Online
        </a>
        <a href="/reservations" class="rc-btn-secondary rounded-2xl px-8 py-3.5 text-base font-bold shadow-xl transition-all hover:scale-105 hover:-translate-y-0.5 active:scale-95">
          📅 Reserve a Table
        </a>
      </div>
    </div>
  </section>

  <!-- Featured items -->
  {featured && featured.length > 0 && (
    <section class="mx-auto max-w-7xl px-4 py-16">
      <h2 class="text-3xl font-bold mb-8 text-center">Chef's Picks</h2>
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {featured.map((item: { id: string; name: string; description: string | null; price_cents: number; image_url: string | null }) => (
          <div class="rounded-xl border overflow-hidden hover:shadow-lg transition-shadow">
            {item.image_url && (
              <img src={item.image_url} alt={item.name} class="h-48 w-full object-cover" />
            )}
            <div class="p-4">
              <h3 class="font-semibold text-lg">{item.name}</h3>
              {item.description && <p class="text-sm text-muted-foreground mt-1">{item.description}</p>}
              <p class="font-bold mt-2">${(item.price_cents / 100).toFixed(2)}</p>
            </div>
          </div>
        ))}
      </div>
      <div class="text-center mt-8">
        <a href="/menu" class="text-primary font-medium hover:underline">View full menu →</a>
      </div>
    </section>
  )}

  <!-- Value props -->
  <section class="bg-muted/40 py-16 px-4">
    <div class="mx-auto max-w-5xl grid grid-cols-1 gap-8 sm:grid-cols-3 text-center">
      <div>
        <div class="text-4xl mb-3">🚀</div>
        <h3 class="font-semibold">Fast Pickup</h3>
        <p class="text-sm text-muted-foreground mt-1">Ready in 20–30 minutes</p>
      </div>
      <div>
        <div class="text-4xl mb-3">⭐</div>
        <h3 class="font-semibold">Loyalty Rewards</h3>
        <p class="text-sm text-muted-foreground mt-1">Earn points on every order</p>
      </div>
