        <rect x="400" y="255" width="3"    height="65" fill="#c090a0" opacity="0.3"/>
        <rect x="550" y="255" width="3"    height="65" fill="#c090a0" opacity="0.3"/>
        <rect x="700" y="255" width="3"    height="65" fill="#c090a0" opacity="0.3"/>
        <rect x="850" y="255" width="3"    height="65" fill="#c090a0" opacity="0.3"/>
        <rect x="1000" y="255" width="3"   height="65" fill="#c090a0" opacity="0.3"/>
        <rect x="1150" y="255" width="3"   height="65" fill="#c090a0" opacity="0.3"/>
        <rect x="1300" y="255" width="3"   height="65" fill="#c090a0" opacity="0.3"/>

