        <rect x="87"  y="162" width="51" height="40" fill="#e0d0f8" rx="26" opacity="0.8"/>
        <rect x="150" y="160" width="55" height="70" fill="#e8c0d8" rx="28" opacity="0.9"/>
        <rect x="152" y="162" width="51" height="40" fill="#f8e0ee" rx="26" opacity="0.8"/>
