---
import BaseLayout from '../layouts/BaseLayout.astro';

const supabase = Astro.locals.supabase;
const { data: featured } = supabase ? await supabase
  .from('menu_items')
  .select('id,name,description,price_cents,image_url')
  .eq('is_featured', true)
  .eq('is_available', true)
  .limit(3) : { data: null };
---

<BaseLayout title="Restaurant — Fine Dining" description="Welcome to our restaurant. Order online, make reservations, and earn rewards.">

  <!-- Hero: Restaurant City Game Style (flat 2D side-scrolling) -->
  <section class="rc-hero relative overflow-hidden">

    <!-- Sky -->
    <div class="rc-sky absolute inset-0"></div>

    <!-- Background city silhouette -->
    <div class="rc-city-bg absolute bottom-0 left-0 right-0">
      <svg viewBox="0 0 1440 260" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
        <!-- Far background buildings (grey silhouette) -->
        <rect x="0"    y="100" width="60"  height="160" fill="#8fa8c0" rx="3"/>
        <rect x="5"    y="60"  width="50"  height="45"  fill="#8fa8c0" rx="3"/>
        <rect x="65"   y="80"  width="80"  height="180" fill="#7a95b0" rx="3"/>
        <rect x="75"   y="50"  width="60"  height="35"  fill="#7a95b0" rx="3"/>
        <rect x="150"  y="90"  width="70"  height="170" fill="#91a8be" rx="3"/>
        <rect x="225"  y="70"  width="90"  height="190" fill="#7e98b2" rx="3"/>
        <rect x="240"  y="40"  width="60"  height="35"  fill="#7e98b2" rx="3"/>
        <rect x="320"  y="85"  width="75"  height="175" fill="#8ba4ba" rx="3"/>
        <rect x="400"  y="65"  width="85"  height="195" fill="#7896ae" rx="3"/>
        <rect x="415"  y="38"  width="55"  height="30"  fill="#7896ae" rx="3"/>
        <rect x="490"  y="80"  width="70"  height="180" fill="#8aa2b8" rx="3"/>
        <rect x="565"  y="55"  width="95"  height="205" fill="#7a94aa" rx="3"/>
        <rect x="580"  y="30"  width="65"  height="28"  fill="#7a94aa" rx="3"/>
        <rect x="665"  y="75"  width="80"  height="185" fill="#8ba3b9" rx="3"/>
        <rect x="750"  y="60"  width="90"  height="200" fill="#7c96ac" rx="3"/>
        <rect x="765"  y="35"  width="60"  height="28"  fill="#7c96ac" rx="3"/>
        <rect x="845"  y="85"  width="70"  height="175" fill="#8da5bb" rx="3"/>
        <rect x="920"  y="70"  width="85"  height="190" fill="#7a94aa" rx="3"/>
        <rect x="935"  y="42"  width="55"  height="32"  fill="#7a94aa" rx="3"/>
        <rect x="1010" y="80"  width="75"  height="180" fill="#8ca4ba" rx="3"/>
        <rect x="1090" y="60"  width="90"  height="200" fill="#7d97ad" rx="3"/>
        <rect x="1105" y="35"  width="60"  height="28"  fill="#7d97ad" rx="3"/>
        <rect x="1185" y="75"  width="80"  height="185" fill="#8ba3b9" rx="3"/>
        <rect x="1270" y="65"  width="85"  height="195" fill="#7b95ab" rx="3"/>
        <rect x="1285" y="38"  width="55"  height="30"  fill="#7b95ab" rx="3"/>
        <rect x="1360" y="85"  width="80"  height="175" fill="#8da5bb" rx="3"/>
        <!-- Windows on bg buildings -->
        <rect x="12"   y="75"  width="10" height="8" fill="#c8dff0" rx="1" opacity="0.7"/>
        <rect x="28"   y="75"  width="10" height="8" fill="#c8dff0" rx="1" opacity="0.6"/>
        <rect x="78"   y="65"  width="10" height="8" fill="#c8dff0" rx="1" opacity="0.7"/>
        <rect x="95"   y="65"  width="10" height="8" fill="#c8dff0" rx="1" opacity="0.6"/>
        <rect x="235"  y="58"  width="10" height="8" fill="#c8dff0" rx="1" opacity="0.7"/>
        <rect x="260"  y="58"  width="10" height="8" fill="#c8dff0" rx="1" opacity="0.6"/>
        <rect x="410"  y="52"  width="10" height="8" fill="#c8dff0" rx="1" opacity="0.7"/>
        <rect x="435"  y="52"  width="10" height="8" fill="#c8dff0" rx="1" opacity="0.6"/>
        <rect x="580"  y="45"  width="10" height="8" fill="#c8dff0" rx="1" opacity="0.7"/>
        <rect x="605"  y="45"  width="10" height="8" fill="#c8dff0" rx="1" opacity="0.6"/>
      </svg>
    </div>

    <!-- Clouds -->
    <div class="rc-cloud rc-cloud-1 absolute"></div>
    <div class="rc-cloud rc-cloud-2 absolute"></div>
