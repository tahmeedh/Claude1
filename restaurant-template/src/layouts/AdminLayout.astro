---
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = 'Admin' } = Astro.props;
const currentPath = Astro.url.pathname;

const navItems = [
  { href: '/admin', label: 'Dashboard', icon: '📊' },
  { href: '/admin/menu', label: 'Menu', icon: '🍽' },
  { href: '/admin/orders', label: 'Orders', icon: '📦' },
  { href: '/admin/reservations', label: 'Reservations', icon: '📅' },
  { href: '/admin/loyalty', label: 'Loyalty', icon: '⭐' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — Admin</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="min-h-screen bg-background font-sans antialiased">
    <div class="flex h-screen overflow-hidden">
      <!-- Sidebar -->
      <aside class="w-64 shrink-0 border-r bg-card flex flex-col">
        <div class="px-6 py-4 border-b">
          <a href="/" class="text-lg font-bold text-primary">🍽 Restaurant</a>
          <p class="text-xs text-muted-foreground mt-0.5">Admin Panel</p>
        </div>
        <nav class="flex-1 px-3 py-4 space-y-1">
          {navItems.map(({ href, label, icon }) => (
            <a
              href={href}
              class={`flex items-center gap-3 rounded-lg px-3 py-2 text-sm font-medium transition-colors ${
                currentPath === href
                  ? 'bg-primary text-primary-foreground'
                  : 'text-muted-foreground hover:bg-accent hover:text-accent-foreground'
              }`}
            >
              <span>{icon}</span>
              {label}
            </a>
          ))}
        </nav>
        <div class="px-6 py-4 border-t">
          <a href="/" class="text-xs text-muted-foreground hover:text-foreground">← Back to site</a>
        </div>
      </aside>

      <!-- Main content -->
      <div class="flex-1 flex flex-col overflow-hidden">
        <header class="border-b bg-background px-6 py-4">
          <h1 class="text-xl font-semibold">{title}</h1>
        </header>
        <main class="flex-1 overflow-y-auto p-6">
          <slot />
        </main>
      </div>
    </div>
  </body>
</html>
