---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title = 'Restaurant', description = 'Welcome to our restaurant' } = Astro.props;
const user = Astro.locals.user;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="min-h-screen bg-background font-sans antialiased">
    <header class="sticky top-0 z-40 border-b bg-background/95 backdrop-blur">
      <nav class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3">
        <a href="/" class="text-xl font-bold text-primary">🍽 Restaurant</a>
        <div class="flex items-center gap-6">
          <a href="/menu" class="text-sm font-medium hover:text-primary">Menu</a>
          <a href="/reservations" class="text-sm font-medium hover:text-primary">Reservations</a>
          <a href="/loyalty" class="text-sm font-medium hover:text-primary">Loyalty</a>
          {user
            ? <a href="/account/orders" class="text-sm font-medium hover:text-primary">My Orders</a>
            : <a href="/account/login" class="text-sm font-medium hover:text-primary">Sign In</a>
          }
        </div>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="border-t bg-muted/40 py-8 mt-16">
      <div class="mx-auto max-w-7xl px-4 text-center text-sm text-muted-foreground">
        <p>&copy; {new Date().getFullYear()} Restaurant. All rights reserved.</p>
      </div>
    </footer>
  </body>
</html>
